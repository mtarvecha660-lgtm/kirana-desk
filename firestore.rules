rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This Firebase project is dedicated to the family dispatch register.
    // Create only the family accounts in Firebase Authentication.
    match /workspaces/kiranaDesk/{collection}/{recordId} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
